# ==============================================================================
# LLMOps Control Center — Environment Configuration Template
# ==============================================================================
# Dedicated non-conflicting port preferences
# All ports must be verified prior to starting services

# Backend API Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8210
APP_ENV=development

# Security, Rate Limiting & Timeouts (Backend)
# Optional API Key to protect mutating endpoints (POST, PUT, PATCH, DELETE)
ADMIN_API_KEY=
REQUEST_TIMEOUT_SECS=30
RATE_LIMIT_RPM=120

# Frontend UI Configuration
FRONTEND_PORT=3210
# Comma-separated allowed CORS origins (supports wildcard subdomains like https://*.vercel.app)
FRONTEND_ORIGIN=http://localhost:3210,https://*.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:8210
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3310
# Must match ADMIN_API_KEY when API authentication is enabled
NEXT_PUBLIC_ADMIN_API_KEY=

# Database Persistence (Dual Driver Support)
# Default: Zero-dependency embedded SQLite (auto WAL mode & Foreign Keys enabled)
DATABASE_URL=sqlite://data/llmops.db?mode=rwc
# Alternative PostgreSQL configuration:
# DATABASE_URL=postgres://llmops_user:llmops_pass@localhost:55432/llmops_db

# AI Gateway & Optional External LLM-as-a-Judge
LLM_GATEWAY_UPSTREAM_URL=https://api.openai.com/v1
LLM_GATEWAY_API_KEY=
LLM_JUDGE_MODEL=gpt-4o-mini

# Integrations & Alerting Webhooks Configuration (Optional)
MLFLOW_TRACKING_URI=http://localhost:5500
WANDB_API_KEY=
PROMETHEUS_URL=http://localhost:9190
GRAFANA_URL=http://localhost:3310
GITHUB_REPO=MTaufikIqball00/LLMOps-Evaluasi-Model-End-To-End
GITHUB_TOKEN=
ALERT_WEBHOOK_URL=
KUBERNETES_IN_CLUSTER=false
