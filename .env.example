# ==============================================================================
# LLMOps Control Center — Environment Configuration Template
# ==============================================================================
# Dedicated non-conflicting port preferences
# All ports must be verified prior to starting services

# Backend API Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8210
APP_ENV=development

# Frontend UI Configuration
FRONTEND_PORT=3210
FRONTEND_ORIGIN=http://localhost:3210
NEXT_PUBLIC_API_URL=http://localhost:8210

# Database Persistence
# Default: Zero-dependency embedded SQLite with SQLx connection pooling
DATABASE_URL=sqlite://data/llmops.db?mode=rwc
# Alternative PostgreSQL configuration:
# DATABASE_URL=postgres://llmops_user:llmops_pass@localhost:55432/llmops_db

# Integrations Configuration (Optional)
MLFLOW_TRACKING_URI=http://localhost:5500
WANDB_API_KEY=
PROMETHEUS_URL=http://localhost:9190
GRAFANA_URL=http://localhost:3310
GITHUB_REPO=enterprise/llmops-platform
GITHUB_TOKEN=
KUBERNETES_IN_CLUSTER=false
